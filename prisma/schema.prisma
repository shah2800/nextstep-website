// Prisma schema for FES Higher Education Consultants
// Full-stack study abroad consultancy platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Country {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  flagEmoji       String
  tagline         String
  shortDesc       String
  longDesc        String
  capital         String
  currency        String
  language        String
  tuitionRange    String
  livingCost      String
  visaProcess     String
  topUniversities String
  popularCourses  String
  intakeMonths    String
  scholarships    String
  workRights      String
  gradient        String
  accentColor     String
  featured        Boolean  @default(false)
  order           Int      @default(0)
  hidden          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
}

model GuidanceRequest {
  id                String   @id @default(cuid())
  name              String
  email             String
  phone             String
  qualification     String
  graduationYear    String
  preferredCourse   String
  budget            String
  englishTest       String
  preferredCountries String
  message           String
  status            String   @default("new")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([email])
}

model BookingSession {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  preferredDate String
  preferredTime String
  mode          String
  service       String
  message       String
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

// ---- Analytics ----
model Visit {
  id         String   @id @default(cuid())
  sessionId  String   @unique
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @default(now())
  pageViews  Int      @default(1)
  referrer   String   @default("")
  userAgent  String   @default("")
  createdAt  DateTime @default(now())

  @@index([lastSeen])
}

model ClickEvent {
  id           String   @id @default(cuid())
  sessionId    String
  elementType  String
  elementLabel String
  section      String
  createdAt    DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model SectionView {
  id         String   @id @default(cuid())
  sessionId  String
  sectionId  String
  enteredAt  DateTime @default(now())
  durationMs Int      @default(0)

  @@index([sessionId])
  @@index([sectionId])
}

// ---- Editable site content (CMS) ----
model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---- Applications (Apply page) ----
model Application {
  id                 String   @id @default(cuid())
  registrationId     String   @unique
  fullName           String
  fatherName         String   @default("")
  dob                String   @default("")
  gender             String   @default("")
  phone              String
  email              String
  cityAddress        String   @default("")
  passportNumber     String   @default("")
  passportIssueDate  String   @default("")
  passportExpiry     String   @default("")
  matricGrade        String   @default("")
  fscGrade           String   @default("")
  otherDegree        String   @default("")
  ieltsScore         String   @default("")
  countryInterest    String
  universityInterest String   @default("")
  courseInterest     String   @default("")
  documents          String   @default("") // JSON of file names
  status             String   @default("submitted")
  headline           String   @default("Application received — our team is reviewing your documents.")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  milestones         ApplicationMilestone[]

  @@index([registrationId])
  @@index([status])
}

model ApplicationMilestone {
  id            String      @id @default(cuid())
  applicationId String
  label         String
  note          String      @default("")
  status        String      @default("pending") // done | active | issue | pending
  order         Int         @default(0)
  updatedAt     DateTime    @default(now()) @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// ---- SEO blog engine (posts written by admins or the daily AI agent) ----
model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String   @default("")
  content         String // markdown
  category        String   @default("Guides")
  tags            String   @default("") // comma-separated
  metaTitle       String   @default("")
  metaDescription String   @default("")
  coverEmoji      String   @default("🎓")
  source          String   @default("manual") // manual | agent
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, createdAt])
  @@index([category])
}
